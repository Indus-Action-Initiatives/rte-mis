{#
/**
 * @file
 * Theme implementation for the school admin dashboard.
 *
 * Available variables:
 * - notifications: Array of recent notifications.
 * - preference_count: Total number of preferred students.
 * - allotted_count: Total number of allotted students.
 * - admitted_count: Total number of admitted students.
 * - seat_status: Array of seat status data by academic year.
 * - claims_status: Array of claims status data by academic year.
 * - years: Array of the last three academic years.
 *
 * @see template_preprocess_rte_mis_school_dashboard()
 *
 * @ingroup themeable
 */
#}
<style>
  table {
    width: 100%;
    border-collapse: collapse;
  }
  table, th, td {
    border: 1px solid black;
  }
  th, td {
    padding: 8px;
    text-align: center;
  }
  .rte-mis-school-dashboard {
    padding: 20px;
  }
  .notifications ul {
    list-style-type: none;
    padding: 0;
  }
  .number-cards .cards-container {
    display: flex;
    gap: 20px;
    margin-top: 10px;
  }
  .card {
    border: 1px solid #ccc;
    padding: 10px;
    border-radius: 5px;
    text-align: center;
    flex: 1;
  }
</style>
<div class="rte-mis-school-dashboard">
  <section class="notifications">
    <h2>Notifications Board</h2>
    {% if notifications %}
      <ul>
        {% for notification in notifications %}
          <li>{{ notification }}</li>
        {% endfor %}
      </ul>
    {% else %}
      <p>No recent notifications.</p>
    {% endif %}
  </section>

  <section class="number-cards">
    <h2>Student Overview</h2>
    <div class="cards-container">
      <div class="card">
        <h3>Total Preferred Students</h3>
        <p>{{ preference_count }}</p>
      </div>
      <div class="card">
        <h3>Total Allotted Students</h3>
        <p>{{ allotted_count }}</p>
      </div>
      <div class="card">
        <h3>Total Admitted Students</h3>
        <p>{{ admitted_count }}</p>
      </div>
    </div>
  </section>

  <section class="seat-allotment">
    <h2>Seat Allotment Status (Last 3 Years)</h2>
    <table>
      <thead>
        <tr>
          <th>Academic Year</th>
          <th>Preferred</th>
          <th>Allotted</th>
          <th>Dropped</th>
          <th>Admitted</th>
        </tr>
      </thead>
      <tbody>
        {% for year in years %}
          <tr>
            <td>{{ year }}</td>
            <td>{{ seat_status[year].preferred }}</td>
            <td>{{ seat_status[year].allotted }}</td>
            <td>{{ seat_status[year].dropped }}</td>
            <td>{{ seat_status[year].admitted }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </section>

  <section class="reimbursement-claims">
    <h2>Reimbursement Claims Status (Last 3 Years)</h2>
    <table>
      <thead>
        <tr>
          <th>Academic Year</th>
          <th>Admitted Students</th>
          <th>Claim Raised (Amount)</th>
          <th>Claims Approved (Last Authority)</th>
          <th>Receipt Status (Amount Received)</th>
        </tr>
      </thead>
      <tbody>
        {% for year in years %}
          <tr>
            <td>{{ year }}</td>
            <td>{{ claims_status[year].admitted }}</td>
            <td>{{ claims_status[year].claim_raised }}</td>
            <td>{{ claims_status[year].claims_approved }}</td>
            <td>{{ claims_status[year].receipt_status }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </section>
</div>