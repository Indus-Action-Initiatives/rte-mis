{#
/**
 * @file
 * View template to display testimonials using the testimonial-items component.
 */
#}
{{ attach_library('rte_mis_theme/testimonial-items') }}

{% set testimonial_items = [] %}

{% for row in rows %}
	{% set entity = row.content['#row']._entity %}
	{% set feedback = entity.field_person_feedback[0].value|striptags %}

	{# Get image URL #}
	{% set image_url = '' %}
	{% if entity.field_person_image|length %}
		{% set image_url = file_url(entity.field_person_image.entity.fileuri) %}
	{% endif %}

	{% set testimonial_items = testimonial_items|merge([{
    'image': image_url,
    'name': entity.title[0].value,
    'meta': entity.field_person_position[0].value,
    'feedback': feedback,
    'location': '',
  }]) %}
{% endfor %}

{% include 'rte_mis_theme:testimonial-items' with {
  'title': 'Success Stories',
  'subtitle': 'Hear from families who successfully enrolled through RTE',
  'items': testimonial_items,
} only %}
