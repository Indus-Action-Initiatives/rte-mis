{% set formatted_class_ages = [] %}
{% for class_age in class_ages %}
  {% set formatted_class_ages = formatted_class_ages|merge([class_age.label ~ ': ' ~ class_age.value]) %}
{% endfor %}

{% set three_column_content %}
{% include 'rte_mis_theme:eligibility-block' with {
    title: 'Eligibility Criteria'|t,
    show_class_age: show_class_age,
    class_ages: formatted_class_ages|default([]),
    eligibility: eligibility|default([]),
    priorities: priorities|default([])
  } only %}
{% endset %}

{% include 'rte_mis_theme:container' with {
  bg_color: 'white',
  max_width: 'xl',
  padding_y: 'lg',
  padding_x: 'sm',
  content: three_column_content
} only %}

<div class="eligibility-criteria-block">
  <div class="seat-now">
    <h3>{% trans "Book A Seat Now" %}</h3>
    <p>{% trans "Secure your seat now for a transformative journey towards education equity and empowerment! Learn about the universal right to education, its significance, and how to advocate for it. Join us in shaping a world where every individual enjoys access to quality education, unlocking boundless opportunities and potential." %}</p>
    <div class="eligibility-criteria-cta">
      {% if student_registration_status %}
        <a href={{ path('rte_mis_student.login.form') }} class="apply-link">{% trans "Apply Now" %}</a>
      {% else %}
        <a class="apply-link disabled" onclick="return false;">{% trans "Apply Now" %}</a>
        <p class="registration-closed">{% trans "Registration is now closed." %}</p>
      {% endif %}
    </div>
  </div>
</div>
