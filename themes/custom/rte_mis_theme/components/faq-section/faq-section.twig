{#
/**
 * @file faq-section.twig
 * FAQ section component.
 */
#}
{% embed 'rte_mis_theme:container' with {
  bg_color: 'light',
  padding_y: 'lg',
  padding_x: 'sm',
  max_width: 'lg',
  tag: 'section',
  attributes: attributes|default(create_attribute()).addClass('c-faq-section').setAttribute('id', 'faq')
} %}
	{% block content %}
		{% if title %}
			<h2 class="c-faq-section__title">{{ title|raw }}</h2>
		{% endif %}

		<div class="c-faq-section__items">
			{% for item in items %}
				<div class="c-faq-section__item">
					{{ include('rte_mis_theme:accordion', item, with_context = false) }}
				</div>
			{% endfor %}
			{% if view_all_link and view_all_link.url %}
				<div class="c-faq-section__footer" style="margin-top: 2rem; display: flex; justify-content: center;">
					{% include 'rte_mis_theme:button' with {
					label: view_all_link.text|default('View All'|t),
					url: view_all_link.url,
					variant: 'primary',
					show_arrow: true
			} only %}
				</div>
			{% endif %}
		</div>
	{% endblock %}
{% endembed %}
