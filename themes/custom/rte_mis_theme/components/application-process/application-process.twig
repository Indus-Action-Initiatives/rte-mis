<section class="c-application-process">
  {% set svgIcons = {
    'register': '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg>',
    'document': '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>',
    'upload': '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>',
    'school': '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>',
    'submit': '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>',
    'track': '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>'
  } %}

  <div class="c-application-process__header">
    <h2 class="c-application-process__title">{{ title }}</h2>
    {% if subtitle %}
      <p class="c-application-process__subtitle">{{ subtitle }}</p>
    {% endif %}
  </div>

  <div class="c-application-process__timeline">
    <div class="c-application-process__line"></div>
    <div class="c-application-process__steps">
      {% for step in steps %}
        <div class="c-application-process__step">
          <div class="c-application-process__icon">
            {% set render_icon = step.icon ? svgIcons[step.icon]|default(svgIcons['track']) : svgIcons['track'] %}
            {{ render_icon|raw }}
          </div>
          <h3 class="c-application-process__step-title">{{ step.title }}</h3>
          <p class="c-application-process__step-desc">{{ step.description }}</p>
        </div>
      {% endfor %}
    </div>
  </div>

  {% if show_guidelines and guidelines %}
    <div class="c-application-process__guidelines">
      <!-- Right Column: Guidelines -->
      <div class="guidelines-column">
        <div class="guidelines-card">
          <h3 class="guidelines-title">{{ guidelines.title }}</h3>
          <ul class="guidelines-list">
            {% for item in guidelines.items %}
              <li class="guideline-item">
                <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                <span>{{ item }}</span>
              </li>
            {% endfor %}
          </ul>
          <a href="{{ guidelines.button.url }}" class="apply-btn">
            {{ guidelines.button.text }}
            <svg class="btn-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  {% endif %}
</section>
