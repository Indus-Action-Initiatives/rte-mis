<section class="c-videos-grid">

  {% if title %}
    <h2 class="c-videos-grid__title">{{ title|raw }}</h2>
  {% endif %}

  <div class="c-videos-grid__items">
    {% for item in items %}
      <div class="c-videos-grid__item">
        {{ include('rte_mis_theme:video-card', item, with_context = false) }}
      </div>
    {% endfor %}
  </div>

  {% if view_all_url %}
    <div class="c-videos-grid__footer">
      <a href="{{ view_all_url }}" class="c-videos-grid__view-all">
        {{ 'View All'|t }}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="c-videos-grid__view-all-icon">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  {% endif %}
</section>
