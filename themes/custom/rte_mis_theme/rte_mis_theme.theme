<?php

/**
 * Implements hook_theme_suggestions_views_view_unformatted_alter().
 */
function rte_mis_theme_theme_suggestions_views_view_unformatted_alter(array &$suggestions, array $variables)
{
    $view = $variables['view'];

    if ($view->id() === 'videos') {
        $display_id = $view->current_display;

        $suggestions[] = 'views_view_unformatted__videos__' . $display_id;
    }

    if ($view->id() === 'news_updates') {
        $display_id = $view->current_display;
        $suggestions[] = 'views_view_unformatted__news_updates__' . $display_id;
    }

    if ($view->id() === 'school_search') {
        $display_id = $view->current_display;
        $suggestions[] = 'views_view_unformatted__school_search';
        $suggestions[] = 'views_view_unformatted__school_search__' . $display_id;
    }
}

/**
 * Summary of rte_mis_theme_theme_suggestions_views_exposed_form_alter
 * @param array $suggestions
 * @param array $variables
 * @return void
 */
function rte_mis_theme_theme_suggestions_views_exposed_form_alter(array &$suggestions, array $variables)
{
    if (!empty($variables['form']['#id'])) {

        $form_id = $variables['form']['#id'];

        // Example: views-exposed-form-faq-page-1
        if (strpos($form_id, 'views-exposed-form-') === 0) {
            $parts = explode('-', $form_id);

            // views-exposed-form-[view]-[display]
            if (count($parts) >= 5) {
                $view_id = $parts[3];
                $display_id = $parts[4];

                $suggestions[] = 'views_exposed_form__' . $view_id;
                $suggestions[] = 'views_exposed_form__' . $view_id . '__' . $display_id;
            }
        }
    }
}

/**
 * Implements hook_preprocess_views_exposed_form().
 *
 * Extracts individual filter fields and the actions element so the
 * filter-form SDC component can render them with our design-system classes.
 */
function rte_mis_theme_preprocess_views_exposed_form(&$variables)
{
    $form = $variables['form'];
    $fields = [];
    $actions = NULL;

    foreach ($form as $key => $element) {
        // Skip Drupal internal keys (start with #).
        if (str_starts_with((string)$key, '#')) {
            continue;
        }
        if ($key === 'actions') {
            $actions = $element;
        }
        else {
            $fields[] = $element;
        }
    }

    $variables['fields'] = $fields;
    $variables['actions'] = $actions;
}

/**
 * Implement hook_form_alter()
 */
function rte_mis_theme_form_alter(&$form, &$form_state, $form_id)
{
    if ($form_id === 'lang_dropdown_form') {

        if (isset($form['lang_dropdown_select']['#options'])) {

            $languages = \Drupal::languageManager()->getLanguages();

            foreach ($form['lang_dropdown_select']['#options'] as $langcode => &$label) {

                if (isset($languages[$langcode])) {

                    $language = $languages[$langcode];

                    // ✅ English name
                    // $label = $language->getName();

                    // 🔥 Native name (correct way)
                    $config = \Drupal::config("language.entity.$langcode");

                    if ($config) {
                        $native = $config->get('label');
                        $label = $native ?: $language->getName();
                    }
                }
            }
        }
    }
}

/**
 * Implements hook_preprocess_views_view_unformatted().
 */
function rte_mis_theme_preprocess_views_view_unformatted(&$variables) {
    $view = $variables['view'];

    if ($view->id() === 'school_search') {
        foreach ($variables['rows'] as &$row) {
            if (isset($row['content']['#row']->_entity->field_udise_code->value)) {
                $udise_code = $row['content']['#row']->_entity->field_udise_code->value;
                $row['content']['#udise_code'] = $udise_code;
                //render taxonomy label for udise code field
                $term = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->load($udise_code);
                if ($term) {
                    $row['content']['#udise_code_label'] = $term->label();
                }
            }
        }
    }
}
