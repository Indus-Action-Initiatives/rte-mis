<?php

/**
 * Implements hook_theme_suggestions_views_view_unformatted_alter().
 */
function rte_mis_theme_theme_suggestions_views_view_unformatted_alter(array &$suggestions, array $variables)
{
    $view = $variables['view'];

    if ($view->id() === 'videos') {
        $display_id = $view->current_display;

        $suggestions[] = 'views_view_unformatted__videos__' . $display_id;
    }

    if ($view->id() === 'news_updates') {
        $display_id = $view->current_display;
        $suggestions[] = 'views_view_unformatted__news_updates__' . $display_id;
    }
}

/**
 * Implements hook_preprocess_views_exposed_form().
 *
 * Extracts individual filter fields and the actions element so the
 * filter-form SDC component can render them with our design-system classes.
 */
function rte_mis_theme_preprocess_views_exposed_form(&$variables) {
    $form = $variables['form'];
    $fields = [];
    $actions = NULL;

    foreach ($form as $key => $element) {
        // Skip Drupal internal keys (start with #).
        if (str_starts_with((string) $key, '#')) {
            continue;
        }
        if ($key === 'actions') {
            $actions = $element;
        }
        else {
            $fields[] = $element;
        }
    }

    $variables['fields'] = $fields;
    $variables['actions'] = $actions;
}

/**
 * Implement hook_form_alter()
 */
function rte_mis_theme_form_alter(&$form, &$form_state, $form_id)
{
    if ($form_id === 'lang_dropdown_form') {

        if (isset($form['lang_dropdown_select']['#options'])) {

            $languages = \Drupal::languageManager()->getLanguages();

            foreach ($form['lang_dropdown_select']['#options'] as $langcode => &$label) {

                if (isset($languages[$langcode])) {

                    $language = $languages[$langcode];

                    // ✅ English name
                    // $label = $language->getName();

                    // 🔥 Native name (correct way)
                    $config = \Drupal::config("language.entity.$langcode");

                    if ($config) {
                        $native = $config->get('label');
                        $label = $native ?: $language->getName();
                    }
                }
            }
        }
    }
}
