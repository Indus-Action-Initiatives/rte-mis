{% if attach_library is defined %}
	{{ attach_library('rte_mis_theme/hero-banner') }}
{% endif %}

<div class="c-hero-banner" role="region" aria-label="Hero section">
	{% if background_image_url %}
		<img class="c-hero-banner__background_image" src="{{ background_image_url|default('https://images.unsplash.com/photo-1503676260728-1c00da094a0b?auto=format&fit=crop&w=1400&q=80') }}" alt="Students in uniform"/>
	{% endif %}
	<div class="c-hero-banner__content">
		{% if content %}
			{{ content }}
		{% endif %}
		{% if links and links|length > 0 %}

			<div class="c-hero-banner__actions">
				{% for link in links %}
					<a class="c-hero-banner__button c-hero-banner__button--{{ loop.first ? 'primary' : 'secondary' }}" href="{{ link.url }}">
						{{ link.title }}
						<svg width="16" height="16" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
					</a>
				{% endfor %}
			</div>
		{% endif %}
	</div>
	<div class="c-hero-banner__image-container">
		<img class="c-hero-banner__image" src="{{ image_url|default('https://images.unsplash.com/photo-1503676260728-1c00da094a0b?auto=format&fit=crop&w=1400&q=80') }}" alt="Students in uniform"/>
	</div>
</div>
