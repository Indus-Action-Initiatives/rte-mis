{#
/**
 * @file news-card.twig
 * News Card component template.
 *
 * Available variables:
 * - image: The image URL or render array.
 * - title: The title of the news update.
 * - date: The date of the news update.
 * - url: Optional URL to make the whole card clickable.
 * - attributes: Drupal Attributes object.
 *
 * BEM structure:
 *   .c-news-card           (block)
 *   .c-news-card__link     (element)
 *   .c-news-card__image    (element)
 *   .c-news-card__content  (element)
 *   .c-news-card__title    (element)
 *   .c-news-card__date     (element)
 */
#}
<article class="c-news-card" {{ attributes }}>
	<div class="c-news-card__image-wrapper">
		{% if image is iterable %}
			{{ image }}
		{% elseif image %}
			<img src="{{ image }}" alt="{{ title }}" class="c-news-card__image">
		{% endif %}
	</div>

	<div class="c-news-card__content">
		<h3 class="c-news-card__title">{{ title }}</h3>
		{% if date %}
			<div class="c-news-card__date">{{ date }}</div>
		{% endif %}
	</div>

	<div class="c-news-card__cta">
		<button type="button" class="c-news-card__modal-trigger" aria-haspopup="dialog" aria-expanded="false">
			READ MORE
			<svg width="16" height="16" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
		</button>
	</div>
	<dialog class="c-news-card__modal">
		<div class="c-news-card__modal-overlay" data-close-modal></div>
		<div class="c-news-card__modal-content">
			<button type="button" class="c-news-card__modal-close" data-close-modal aria-label="Close modal">
				<svg viewbox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
					<line x1="18" y1="6" x2="6" y2="18"></line>
					<line x1="6" y1="6" x2="18" y2="18"></line>
				</svg>
			</button>
			<div class="c-news-card__modal-header">
				<h3 class="c-news-card__modal-title">{{ title }}</h3>
				{% if date %}
					<div class="c-news-card__modal-date">{{ date }}</div>
				{% endif %}
			</div>
			<div class="c-news-card__modal-body">
				{% if image is iterable %}
					<div class="c-news-card__modal-image">{{ image }}</div>
				{% elseif image %}
					<div class="c-news-card__modal-image"><img src="{{ image }}" alt="{{ title }}"></div>
				{% endif %}
				<div class="c-news-card__modal-desc">{{ description|raw }}</div>
			</div>
		</div>
	</dialog>

</article>
